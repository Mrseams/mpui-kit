{
  "name": "@mpui-kit/core",
  "version": "0.1.0",
  "description": "Framework-free core of MPUI-KIT: a Mobile Money checkout controller, phone number and FCFA helpers, and FR/EN strings for African markets. Works with React, Vue, Svelte or plain JavaScript.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mrseams/mpui-kit.git",
    "directory": "packages/core"
  },
  "homepage": "https://mpui-kit.vercel.app/docs/headless",
  "bugs": "https://github.com/Mrseams/mpui-kit/issues",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mobile-money",
    "fcfa",
    "xaf",
    "xof",
    "africa",
    "cameroon",
    "checkout",
    "phone-number",
    "headless",
    "framework-agnostic"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
