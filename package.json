{
  "name": "mpui-kit-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@mpui-kit/docs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "registry:build": "shadcn build registry.json --output apps/docs/public/r",
    "registry:check": "node scripts/check-registry.mjs",
    "core:build": "turbo run build --filter=@mpui-kit/core",
    "core:check": "pnpm --filter @mpui-kit/core check",
    "size": "pnpm --filter @mpui-kit/docs size"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.0",
    "turbo": "^2",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.3.4"
}
